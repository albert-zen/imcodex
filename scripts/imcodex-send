#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"
python_bin="${repo_root}/.venv/bin/python"

if [[ ! -x "${python_bin}" ]]; then
    echo "IMCodex virtual environment is unavailable: ${python_bin}" >&2
    exit 2
fi

exec "${python_bin}" -m imcodex channels send \
    --current \
    --bridge-root "${repo_root}" \
    "$@"
