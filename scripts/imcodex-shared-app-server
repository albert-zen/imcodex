#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"
python_bin="${IMCODEX_SHARED_APP_SERVER_PYTHON:-${repo_root}/.venv/bin/python}"

canonical_path() {
    local candidate="$1"
    local link_target
    local link_dir
    local depth
    for ((depth = 0; depth < 32; depth++)); do
        [[ -L "${candidate}" ]] || break
        link_dir="$(cd -- "$(dirname -- "${candidate}")" && pwd -P)"
        link_target="$(readlink "${candidate}")"
        if [[ "${link_target}" == /* ]]; then
            candidate="${link_target}"
        else
            candidate="${link_dir}/${link_target}"
        fi
    done
    [[ ! -L "${candidate}" ]] || return 1
    link_dir="$(cd -- "$(dirname -- "${candidate}")" && pwd -P)"
    printf '%s/%s\n' "${link_dir}" "$(basename -- "${candidate}")"
}

if [[ "${1:-}" != "app-server" ]]; then
    codex_bin="${IMCODEX_SHARED_APP_SERVER_CODEX_BIN:-codex}"
    if [[ "${codex_bin}" == */* ]]; then
        [[ -x "${codex_bin}" ]] || {
            echo "Codex executable for T3 auxiliary commands is unavailable" >&2
            exit 2
        }
    elif ! command -v "${codex_bin}" >/dev/null 2>&1; then
        echo "Codex executable for T3 auxiliary commands is unavailable" >&2
        exit 2
    fi
    codex_path="$(command -v "${codex_bin}")"
    if ! codex_path="$(canonical_path "${codex_path}")"; then
        echo "Codex executable for T3 auxiliary commands is invalid" >&2
        exit 2
    fi
    launcher_path="$(canonical_path "${BASH_SOURCE[0]}")"
    if [[ "${codex_path}" == "${launcher_path}" ]]; then
        echo "Codex executable for T3 auxiliary commands is invalid" >&2
        exit 2
    fi
    exec "${codex_bin}" "$@"
fi

if [[ ! -x "${python_bin}" ]]; then
    echo "IMCodex shared App Server Python is unavailable" >&2
    exit 2
fi

exec "${python_bin}" -m imcodex.appserver.shared_stdio_shim "$@"
